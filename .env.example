# HTTP + WebSocket server port (REST and WS share one server; WS is on path /ws)
PORT=8080

# How often (ms) the backend samples current market state and broadcasts it to
# connected mobile clients. This is decoupled from Binance's own update rate.
BROADCAST_INTERVAL_MS=100

# Comma-separated list of Binance symbols (lowercase, no separator) to track.
PAIRS=btcusdt,ethusdt,solusdt,dogeusdt,xrpusdt

# How often (ms) to poll Binance's 24hr ticker REST endpoint to refresh
# change%, high/low/volume metadata. Kept well above Binance rate limits.
META_POLL_INTERVAL_MS=10000

# Max bytes a client's outbound socket buffer may hold before we skip sending
# it an update for the current tick (backpressure guard).
MAX_CLIENT_BUFFERED_BYTES=1048576

# If true, /pairs/meta falls back to static mock data when the Binance REST
# call fails (e.g. no network egress). Never fails hard either way.
ALLOW_MOCK_META=true
