# Base/default environment. Copy to .env: `cp .env.example .env`. Used by the plain
# dev:broadcast/dev:ingestion scripts and the default `docker compose up --build` target.
# For a ready-to-use environment that needs no copy step, see .env.local (no Docker/Redis
# needed), .env.uat, .env.development, or .env.production instead — all four are already
# checked into the repo (see README "Run").

# --- Server ---
# HTTP + WebSocket server port (REST and WS share one server).
PORT=8080
# Path the WebSocket server listens on.
WS_PATH=/ws

# --- Broadcast ---
# How often (ms) the backend samples current market state and broadcasts it
# to connected mobile clients. Decoupled from Binance's own update rate.
BROADCAST_INTERVAL_MS=100
# Max bytes a client's outbound socket buffer may hold before we skip
# sending it an update for the current tick (backpressure guard).
MAX_CLIENT_BUFFERED_BYTES=1048576

# --- Tracked pairs ---
# Comma-separated list of Binance symbols (lowercase, no separator) to track.
PAIRS=btcusdt,ethusdt,solusdt,dogeusdt,xrpusdt
# How many bid/ask levels to keep and broadcast per pair.
DEPTH_LEVELS=10

# --- Binance ingestion (WebSocket) ---
# Base URL for Binance's combined WebSocket stream. Override to point at
# Binance's testnet (wss://testnet.binance.vision/stream) for testing.
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443/stream
# Depth stream suffix appended to each symbol, e.g. btcusdt@depth20@100ms.
BINANCE_DEPTH_STREAM_SUFFIX=depth20@100ms
# Reconnect backoff schedule toward Binance (exponential, capped at max).
BINANCE_RECONNECT_BASE_DELAY_MS=1000
BINANCE_RECONNECT_MAX_DELAY_MS=30000

# --- Binance metadata polling (REST) ---
# Base URL for Binance's REST API (24hr ticker stats).
BINANCE_REST_BASE_URL=https://api.binance.com
# How often (ms) to poll Binance's 24hr ticker REST endpoint.
META_POLL_INTERVAL_MS=10000
# Timeout (ms) for each metadata fetch attempt.
META_FETCH_TIMEOUT_MS=5000

# --- Redis (shared state between ingestion and broadcast processes) ---
# Ignored by `docker compose up --build` (overridden to the bundled redis container);
# used as-is when running dev:*/start:* scripts directly on your host.
REDIS_URL=redis://localhost:6379

# --- Process topology ---
# "distributed" (default, leave unset) or "standalone" (no Redis, ingestion runs
# in-process — see .env.local for a ready-to-use standalone setup).
# APP_MODE=distributed

# --- Debugging ---
# Verbose logging for troubleshooting — see .env's DEBUG or the :debug script aliases.
# DEBUG=true
