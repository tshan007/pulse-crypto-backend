# Local development config — a working target out of the box, unlike .env.uat/
# .env.production which point at real external infra. Run with `npm run docker:up`
# (bundles its own redis, see docker-compose.yml) or `npm run dev:broadcast:development`
# / `dev:ingestion:development` against a Redis you already have running locally (see
# README "Run"). Distributed mode: broadcast expects a separately-run ingestion process
# publishing to the same Redis.

# --- Process topology ---
APP_MODE=distributed

# --- Server ---
PORT=8080
WS_PATH=/ws

# --- Broadcast ---
BROADCAST_INTERVAL_MS=100
MAX_CLIENT_BUFFERED_BYTES=1048576

# --- Tracked pairs ---
PAIRS=btcusdt,ethusdt,solusdt,dogeusdt,xrpusdt,bnbusdt,adausdt,trxusdt,avaxusdt,dotusdt,linkusdt,maticusdt,ltcusdt,bchusdt,uniusdt,atomusdt,xlmusdt,etcusdt,filusdt,aptusdt,nearusdt,arbusdt,opusdt,vetusdt,icpusdt,hbarusdt,qntusdt,aaveusdt,grtusdt,algousdt,egldusdt,sandusdt,manausdt,axsusdt,thetausdt,ftmusdt,xtzusdt,eosusdt,runeusdt,flowusdt,chzusdt,kavausdt,mkrusdt,snxusdt,crvusdt,compusdt,zecusdt,dashusdt,enjusdt,batusdt,zilusdt,wavesusdt,oneusdt,ksmusdt,iotausdt,neousdt,dydxusdt,galausdt,imxusdt,ldousdt,injusdt,suiusdt,seiusdt,tiausdt,pythusdt,stxusdt,rndrusdt,fetusdt,agixusdt,oceanusdt,ankrusdt,1inchusdt,yfiusdt,sushiusdt,rsrusdt,celrusdt,sklusdt,storjusdt,cvcusdt,glmusdt,antusdt,balusdt,renusdt,umausdt,bandusdt,omgusdt,lrcusdt,zrxusdt,kncusdt,ctsiusdt,cotiusdt,arusdt,maskusdt,woousdt,gmtusdt,apeusdt,jasmyusdt,hotusdt,iostusdt,ontusdt
DEPTH_LEVELS=10

# --- Binance ingestion (WebSocket) ---
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443/stream
BINANCE_DEPTH_STREAM_SUFFIX=depth20@100ms
BINANCE_RECONNECT_BASE_DELAY_MS=1000
BINANCE_RECONNECT_MAX_DELAY_MS=30000

# --- Binance metadata polling (REST) ---
BINANCE_REST_BASE_URL=https://api.binance.com
META_POLL_INTERVAL_MS=10000
META_FETCH_TIMEOUT_MS=5000

# --- Redis ---
# Used as-is for dev:*/start:*:development (needs a real local Redis reachable here).
# docker:up overrides this to the bundled redis container instead — see docker-compose.yml.
REDIS_URL=redis://localhost:6379
