# Shared UAT environment config. Fill in the real UAT Redis host below, then run
# `npm run dev:broadcast:uat` / `dev:ingestion:uat` (see README "Run" section).
# Distributed mode: broadcast expects a separately-run ingestion process publishing
# to the same Redis.

# --- Process topology ---
APP_MODE=distributed

# --- Server ---
PORT=8080
WS_PATH=/ws

# --- Broadcast ---
BROADCAST_INTERVAL_MS=100
MAX_CLIENT_BUFFERED_BYTES=1048576

# --- Tracked pairs ---
PAIRS=btcusdt,ethusdt,solusdt,dogeusdt,xrpusdt,bnbusdt,adausdt,trxusdt,avaxusdt,dotusdt
DEPTH_LEVELS=10

# --- Binance ingestion (WebSocket) ---
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443/stream
BINANCE_DEPTH_STREAM_SUFFIX=depth20@100ms
BINANCE_RECONNECT_BASE_DELAY_MS=1000
BINANCE_RECONNECT_MAX_DELAY_MS=30000

# --- Binance metadata polling (REST) ---
BINANCE_REST_BASE_URL=https://api.binance.com
META_POLL_INTERVAL_MS=10000
META_FETCH_TIMEOUT_MS=5000

# --- Redis ---
# Fill in the actual shared UAT Redis host — this placeholder will fail to connect.
REDIS_URL=redis://uat-redis.internal:6379
